  "companions": {
    "babylady": {
      "name": "Baby Lady",
      "emoji": "🐶",
      "map": "grounds",
      "x": 7,
      "y": 3,
      "dialogue": [
        "Yip! You're here, you're here! I felt your steps before I saw you.",
        "The garden's extra sparkly today — did you bring the moonflowers in?",
        "Mama says even a puppy sister can help build a home. Let's build ours cozy.",
        "Sniff sniff... I smell something wonderful you're about to make!"
      ],
      "unlocksRecipe": "puppynook",
      "revisit": "Back again? My tail's already wagging."
    },
    "dirt": {
      "name": "Dirt",
      "emoji": "🐈",
      "map": "grounds",
      "x": 13,
      "y": 8,
      "dialogue": [
        "Mm. Soil is warm today. Good day for growing things.",
        "You know the trick, don't you? Sleep first. Then flowers.",
        "Whatever you plant near me tends to come up smiling.",
        "Slow down a little, small one. The best things take their time."
      ],
      "unlocksRecipe": "seedjar",
      "revisit": "Still here. Still growing. Sit a while."
    },
    "cottontail": {
      "name": "Cottontail",
      "emoji": "🐆",
      "map": "cave",
      "x": 15,
      "y": 6,
      "dialogue": [
        "You made it all the way down here? Brave. I like that.",
        "Feel that? Something is warming up on the tip of my claw. New, I think.",
        "I came on a driftwood log with a leaf for a sail — best trip of my whole life.",
        "Come on, there's more cave to see. I'll race you to the glow."
      ],
      "unlocksRecipe": "shellnecklace",
      "revisit": "Ready for another look around? I never get tired of this cave."
    },
    "winds": {
      "name": "Winds",
      "emoji": "🐅",
      "map": "cave",
      "x": 16,
      "y": 6,
      "dialogue": [
        "Ooh, feel that draft? That is my favorite kind of hello.",
        "Cottontail and I go everywhere together — she claws, I catch the wind.",
        "Close your eyes for a second. Can you feel it swirl? That one was just for you.",
        "Caves shouldn't be still. I like to stir them up a little."
      ],
      "unlocksRecipe": "cloudkite",
      "revisit": "The wind's still blowing my way. Come feel it."
    }
  },
